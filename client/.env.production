# Production Environment Configuration
# Empty VITE_API_URL instructs api.js to use relative endpoints (/api and /uploads) on the same origin
VITE_API_URL=

# Demo Auth Mode (true: instant auth without OTP, false: real email OTP)
VITE_DEMO_AUTH_MODE=true

# Google OAuth 2.0 Web Client ID (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

