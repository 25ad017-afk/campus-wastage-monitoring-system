# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / Cloud Database)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_waste_db
DB_PORT=3306

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_campus_waste_2026_change_in_production
JWT_EXPIRES_IN=7d

# College Email Domains (Akshaya College of Engineering and Technology)
STUDENT_EMAIL_DOMAIN=@acetcbe.edu.in
STAFF_EMAIL_DOMAIN=@acetcbe.edu.in

# Backend SMTP Email Service (Nodemailer / Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_college_or_personal_email@gmail.com
EMAIL_PASSWORD=your_16_digit_gmail_app_password
EMAIL_FROM="Akshaya College CWMS" <your_college_or_personal_email@gmail.com>

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
