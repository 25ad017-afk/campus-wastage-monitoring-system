# Server Port
PORT=5000
NODE_ENV=production

# Database Configuration (MySQL / Cloud Database)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=campus_waste_db
DB_PORT=3306

# Authentication Secrets
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Optional: set to your deployed frontend domain)
CLIENT_URL=
